.pypirc

# IDEs
.idea/
.vscode/
*.swp
*.swo
*~

# OS files
.DS_Store
Thumbs.db
Desktop.ini

# Cursor
.cursorignore
.cursorindexingignore

# Claude Code (local runtime state — scheduled-task locks etc.)
.claude/

# Docker build artifacts (generated by docker/scripts/build.sh and the CI workflows)
/docker/adapters.requirements.txt
/docker/scripts/_service_env.sh
/docker/scripts/.env
# da-registry-dashboard-api, cloned by the Jenkinsfile
/.build/

# Generated staff-ui checkout and dependency marker.
**/.app/
**/.deps-stamp

# Central chart archives and public values cached for an offline deploy.
.central-charts/

# ci/commons-services/migrate-far-geo.sh dumps the tables it rewrites here (record data).
far-geo-backup-*.sql.gz

# Local checkout of openg2p-data mounted into the seed jobs (OPENG2P_DATA_PATH), never committed
docker/db-seed/openg2p-data-local/

# Files the dev deploy writes into the workspace for Jenkins to archive.
dev-rendered-*.yaml
dev-values-before-*.yaml
deploy-failure-*.txt
