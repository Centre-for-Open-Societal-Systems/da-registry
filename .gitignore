*.pid
*.sock

# Local databases (dev SQLite, dumps)
*.sqlite
*.sqlite3
*.sqlite3-journal
*.db
*.dump
*.sql.bak

# Spyder project settings
.spyderproject
.spyproject

# Rope project settings
.ropeproject

# mkdocs documentation
/site

# mypy
.mypy_cache/
.dmypy.json
dmypy.json

# Pyre type checker
.pyre/

# pytype static type analyzer
.pytype/

# Cython debug symbols
cython_debug/

