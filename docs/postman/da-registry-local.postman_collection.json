{
  "info": {
    "_postman_id": "163e3949-95ed-51f2-b982-2b572befa976",
    "name": "DA Registry (local)",
    "description": "DA Registry APIs for DA Services, against the local docker compose stack. Run 0 first; it stores the token. See docs/da-services-local-setup.md and docs/da-services-staff-api.md.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "0. Get token (local Keycloak, admin/admin)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/x-www-form-urlencoded"
          }
        ],
        "url": {
          "raw": "{{keycloak}}/realms/staff/protocol/openid-connect/token",
          "host": [
            "{{keycloak}}"
          ],
          "path": [
            "realms",
            "staff",
            "protocol",
            "openid-connect",
            "token"
          ]
        },
        "body": {
          "mode": "urlencoded",
          "urlencoded": [
            {
              "key": "grant_type",
              "value": "password"
            },
            {
              "key": "client_id",
              "value": "iam-staff-portal"
            },
            {
              "key": "client_secret",
              "value": "dev-iam-staff-secret"
            },
            {
              "key": "username",
              "value": "admin"
            },
            {
              "key": "password",
              "value": "admin"
            }
          ]
        },
        "description": "Local testing only. In DA Services the token comes from the user's Keycloak sign-in."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const r = pm.response.json();",
              "const v = r.access_token;",
              "if (v) pm.collectionVariables.set('token', v);"
            ]
          }
        }
      ]
    },
